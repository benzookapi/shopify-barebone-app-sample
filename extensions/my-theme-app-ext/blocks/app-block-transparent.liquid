<span
  hidden
  data-barebone-custom-event
  data-event-name="{{ block.settings.barebone_app_event | escape }}"
  data-template-name="{{ template.name | escape }}"
  {{ block.shopify_attributes }}
></span>

{% schema %}
{
  "name": "t:barebone.app_block_transparent.name",
  "target": "section",
  "javascript": "barebone.js",
  "settings": [
    {
      "type": "text",
      "id": "barebone_app_event",
      "label": "t:barebone.app_block_transparent.event_name",
      "default": "barebone_app_custom_event"
    }
  ]
}
{% endschema %}
