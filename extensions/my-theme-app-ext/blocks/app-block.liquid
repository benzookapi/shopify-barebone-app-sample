{%- liquid
  assign cart_attribute = cart.attributes['barebone_cart_attribute'] | default: ''
  assign cart_attribute_code = cart.attributes['barebone_cart_attribute_code'] | default: ''
  assign block_dom_id = 'barebone-app-block-' | append: block.id
-%}

<div
  id="{{ block_dom_id }}"
  class="barebone-app-block"
  style="--barebone-text-color: {{ block.settings.color }};"
  data-barebone-app-block
  data-template-name="{{ template.name | escape }}"
  data-product-id="{{ product.id }}"
  data-selected-variant-id="{{ product.selected_variant.id }}"
  {{ block.shopify_attributes }}
>
  <p>
    {{ 'barebone.shared.theme_app_extension' | t }}
    <a
      href="https://shopify.dev/docs/apps/build/online-store/theme-app-extensions/configuration#app-blocks-for-themes"
      target="_blank"
      rel="noopener noreferrer"
    >
      {{- 'barebone.app_block.name' | t -}}
    </a>
    {{ 'barebone.shared.with' | t }}
    <strong>"target": "section"</strong>
  </p>
  <p>
    {{ 'barebone.shared.in' | t }}
    <code>blocks/app-block.liquid</code>
    {{ 'barebone.app_block.color_description' | t }}
  </p>

  <p>
    <strong>&#123;&#123; product.title &#125;&#125;:</strong>
    {{ product.title | escape }}
  </p>

  {%- if request.design_mode -%}
    <p class="barebone-app-block__editor-message">
      {{ 'barebone.app_block.editor_message' | t }}
    </p>
  {%- endif -%}

  <ul>
    <li>
      <code>block.settings.product</code>
      {{ 'barebone.app_block.product_setting' | t }}:
      <strong>{{ block.settings.product.id }}</strong>
      (id) /
      <strong>{{ block.settings.product.title | escape }}</strong>
      (title) /
      <strong>{{ block.settings.product.price }}</strong>
      (price)
    </li>
    <li>
      <code>block.settings.text</code>
      {{ 'barebone.app_block.text_setting' | t }}:
      <strong>{{ block.settings.text | escape }}</strong>
    </li>
  </ul>

  {% render 'barebone_snippet' %}

  <p>
    <strong>{{ 'barebone.app_block.proxy_responses' | t }}</strong>:
    {{ 'barebone.app_block.proxy_description' | t }}
  </p>
  <ul>
    <li>
      <p>{{ 'barebone.app_block.proxy_post_response' | t }}</p>
      <pre class="barebone-app-proxy-response" data-barebone-proxy-response aria-live="polite"></pre>
    </li>
    <li>
      <a href="" target="_blank" rel="noopener noreferrer" data-barebone-proxy-json>
        {{- 'barebone.app_block.proxy_get_response' | t -}}
      </a>
    </li>
    <li>
      <a href="" data-barebone-proxy-liquid>{{ 'barebone.app_block.proxy_liquid_response' | t }}</a>
    </li>
  </ul>

  <p>
    <a
      href="https://shopify.dev/docs/api/customer-privacy"
      target="_blank"
      rel="noopener noreferrer"
    >
      {{- 'barebone.app_block.shopify_dump' | t -}}
    </a>
  </p>
  <pre data-barebone-shopify-dump></pre>

  {%- if template.name == 'product' -%}
    <fieldset>
      <legend>{{ 'barebone.app_block.line_item_legend' | t }}</legend>
      {%- for index in (1..3) -%}
        {%- assign property_value = 'Value-' | append: index -%}
        {%- assign property_id = block_dom_id | append: '-line-item-property-' | append: index -%}
        <div>
          <input
            type="radio"
            id="{{ property_id }}"
            name="barebone_line_item_property_{{ block.id }}"
            value="{{ property_value }}"
            data-barebone-line-item-property
          >
          <label for="{{ property_id }}">
            {{- 'barebone.shared.value' | t }} {{ index -}}
          </label>
        </div>
      {%- endfor -%}
      <strong>
        {{ 'barebone.shared.see' | t }}
        <a
          href="https://shopify.dev/docs/storefronts/themes/architecture/templates/product#line-item-properties"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{- 'barebone.shared.developer_site' | t -}}
        </a>
        {{ 'barebone.app_block.line_item_documentation' | t }}
      </strong>
    </fieldset>
  {%- endif -%}

  {%- if template.name == 'cart' -%}
    <fieldset>
      <legend>{{ 'barebone.app_block.cart_legend' | t }}</legend>
      <div>
        <textarea
          id="{{ block_dom_id }}-cart-note"
          name="barebone_cart_note"
          data-barebone-cart-note
        ></textarea>
      </div>
      {%- for index in (0..3) -%}
        {%- if index == 0 -%}
          {%- assign attribute_value = '' -%}
        {%- else -%}
          {%- assign attribute_value = 'Value-' | append: index -%}
        {%- endif -%}
        {%- assign attribute_id = block_dom_id | append: '-cart-attribute-' | append: index -%}
        <div>
          <input
            type="radio"
            id="{{ attribute_id }}"
            name="barebone_cart_attribute_{{ block.id }}"
            value="{{ attribute_value }}"
            data-barebone-cart-attribute
            {% if cart_attribute == attribute_value %}checked{% endif %}
          >
          <label for="{{ attribute_id }}">
            {%- if index == 0 -%}
              {{ 'barebone.shared.empty' | t }}
            {%- else -%}
              {{ 'barebone.shared.value' | t }} {{ index }}
            {%- endif -%}
          </label>
        </div>
      {%- endfor -%}
      <div>
        <label for="{{ block_dom_id }}-cart-attribute-code">
          {{- 'barebone.app_block.discount_code_label' | t -}}
        </label>
        <input
          type="text"
          id="{{ block_dom_id }}-cart-attribute-code"
          name="barebone_cart_attribute_code"
          value="{{ cart_attribute_code | escape }}"
          data-barebone-cart-attribute-code
        >
      </div>
      <strong>
        {{ 'barebone.shared.see' | t }}
        <a
          href="https://shopify.dev/docs/storefronts/themes/architecture/templates/cart#support-cart-notes-and-attributes"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{- 'barebone.shared.developer_site' | t -}}
        </a>
        {{ 'barebone.app_block.cart_documentation' | t }}
      </strong>
    </fieldset>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:barebone.app_block.name",
  "target": "section",
  "stylesheet": "barebone.css",
  "javascript": "barebone.js",
  "settings": [
    {
      "type": "color",
      "id": "color",
      "label": "t:barebone.app_block.color",
      "default": "#000000"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:barebone.app_block.product"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:barebone.app_block.text"
    }
  ]
}
{% endschema %}
