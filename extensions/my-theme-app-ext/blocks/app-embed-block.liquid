{%- assign image_alt = 'barebone.app_embed.image_alt' | t -%}

<div
  class="barebone-app-embed"
  data-barebone-app-embed
  data-shop-url="{{ shop.secure_url | escape }}"
  {{ block.shopify_attributes }}
>
  <img
    src="{{ 'barebone.png' | asset_url }}"
    alt="{{ image_alt | escape }}"
    width="200"
    height="200"
    loading="lazy"
  >
  <div class="barebone-app-embed__content">
    <p>
      {{ 'barebone.shared.theme_app_extension' | t }}
      <a
        href="https://shopify.dev/docs/apps/build/online-store/theme-app-extensions/configuration#app-embed-blocks"
        target="_blank"
        rel="noopener noreferrer"
      >
        {{- 'barebone.app_embed.name' | t -}}
      </a>
      {{ 'barebone.shared.with' | t }}
      <strong>"target": "body"</strong>
    </p>
    <p>
      {{ 'barebone.shared.in' | t }}
      <code>blocks/app-embed-block.liquid</code>
      {{ 'barebone.app_embed.background_description' | t }}
    </p>
    <p>
      <strong>&#123;&#123; template.name &#125;&#125;:</strong>
      {{ template.name | escape }}
    </p>
    <ul>
      <li>
        <code>block.settings.text</code>
        {{ 'barebone.app_embed.message_setting' | t }}:
        <strong>{{ block.settings.text | escape }}</strong>
      </li>
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:barebone.app_embed.name",
  "target": "body",
  "stylesheet": "barebone.css",
  "javascript": "barebone.js",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:barebone.app_embed.message",
      "default": "Barebone app embed block message"
    }
  ]
}
{% endschema %}
