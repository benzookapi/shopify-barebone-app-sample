{% doc %}
Renders the reusable content used by the barebone theme app block.

@example
{% render 'barebone_snippet' %}
{% enddoc %}

<div class="barebone-app-snippet">
  <p>
    {{ 'barebone.shared.theme_app_extension' | t }}
    <a
      href="https://shopify.dev/docs/apps/build/online-store/theme-app-extensions/configuration#theme-app-extension-resources"
      target="_blank"
      rel="noopener noreferrer"
    >
      {{- 'barebone.snippet.name' | t -}}
    </a>
    {{ 'barebone.snippet.rendered_by_parent' | t }}
  </p>
  <p>
    {{ 'barebone.shared.in' | t }}
    <code>snippets/barebone_snippet.liquid</code>
    {{ 'barebone.snippet.background_description' | t }}
  </p>
</div>
